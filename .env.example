# OpenAI API Configuration
# To use the standard OpenAI API, keep these settings and add your API key.
# If you want to use a local model like Ollama, change the BASE to http://localhost:11434/v1
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (e.g., 'gpt-4o' or 'gpt-4o-mini' for OpenAI)
LLM_MODEL=gpt-4o-mini
